<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SignalRouter.V2.Replay</AssemblyName>
    <RootNamespace>SignalRouter.V2.Replay</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The replay module (architecture.md §2; ADR 0015): pre-scan, trust
         boundary, and the replay driver over the isolated environment seam.
         Depends up-list on Recording, Comparison, and both state codec leaves. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Recording/SignalRouter.V2.Recording.csproj" />
    <ProjectReference Include="../Comparison/SignalRouter.V2.Comparison.csproj" />
    <ProjectReference Include="../Codec.CanonicalState/SignalRouter.V2.Codec.CanonicalState.csproj" />
    <ProjectReference Include="../Codec.Recording/SignalRouter.V2.Codec.Recording.csproj" />
  </ItemGroup>
</Project>
