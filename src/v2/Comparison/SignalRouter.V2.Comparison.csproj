<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SignalRouter.V2.Comparison</AssemblyName>
    <RootNamespace>SignalRouter.V2.Comparison</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The comparison leaf (ADR 0015): typed exact comparison over the pinned
         ReplayComparisonProfile — Contracts-only, zero dependencies, pure
         functions of its inputs. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Contracts/SignalRouter.V2.Contracts.csproj" />
  </ItemGroup>
</Project>
