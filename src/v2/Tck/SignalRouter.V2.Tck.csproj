<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SignalRouter.V2.Tck</AssemblyName>
    <RootNamespace>SignalRouter.V2.Tck</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The versioned, black-box TCK core (adapter-conformance.md §7.2):
         deliberately free of any test-framework dependency so the same suite runs
         under plain .NET CI and inside engine test runners (e.g. Unity) whose
         bundled NUnit version this repo does not control. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AdapterSdk/SignalRouter.V2.AdapterSdk.csproj" />
    <ProjectReference Include="../Contracts/SignalRouter.V2.Contracts.csproj" />
    <ProjectReference Include="../Kernel/SignalRouter.V2.Kernel.csproj" />
    <!-- The tier-2 recording/replay obligations (item 5): the suite records on
         the harness runtime, pre-scans, and replays into the adapter's twin. -->
    <ProjectReference Include="../Comparison/SignalRouter.V2.Comparison.csproj" />
    <ProjectReference Include="../Replay/SignalRouter.V2.Replay.csproj" />
    <ProjectReference Include="../Codec.CanonicalState/SignalRouter.V2.Codec.CanonicalState.csproj" />
    <ProjectReference Include="../Codec.Recording/SignalRouter.V2.Codec.Recording.csproj" />
  </ItemGroup>
</Project>
