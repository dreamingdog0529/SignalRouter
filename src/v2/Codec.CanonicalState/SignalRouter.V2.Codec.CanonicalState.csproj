<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SignalRouter.V2.Codec.CanonicalState</AssemblyName>
    <RootNamespace>SignalRouter.V2.Codec.CanonicalState</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The canonical-state codec leaf (ADR 0007/0012): representation v1 is a
         hand-rolled, length-framed binary grammar, so this leaf takes no serializer
         dependency at all — the grammar is frozen in ADR 0012 and enforced by
         golden-vector tests. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Contracts/SignalRouter.V2.Contracts.csproj" />
  </ItemGroup>
</Project>
