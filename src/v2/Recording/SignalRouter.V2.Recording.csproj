<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SignalRouter.V2.Recording</AssemblyName>
    <RootNamespace>SignalRouter.V2.Recording</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The durable evidence coordinator (ADR 0015): BCL-only runtime module;
         the artifact serializer lives in the Codec.Recording leaf. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Contracts/SignalRouter.V2.Contracts.csproj" />
    <ProjectReference Include="../Kernel/SignalRouter.V2.Kernel.csproj" />
    <ProjectReference Include="../Codec.Recording/SignalRouter.V2.Codec.Recording.csproj" />
  </ItemGroup>
</Project>
