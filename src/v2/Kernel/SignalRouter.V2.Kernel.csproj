<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SignalRouter.V2.Kernel</AssemblyName>
    <RootNamespace>SignalRouter.V2.Kernel</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Single-owner kernel (kernel-execution.md, ADR 0001/0010). BCL-only per
         ADR 0007; packaging deferred until the distribution decision. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AdapterSdk/SignalRouter.V2.AdapterSdk.csproj" />
    <ProjectReference Include="../Contracts/SignalRouter.V2.Contracts.csproj" />
  </ItemGroup>
</Project>
