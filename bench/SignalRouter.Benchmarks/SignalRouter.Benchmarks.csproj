<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Bench host: net10.0, like the test projects. The production assemblies it
      measures stay netstandard2.1; the PackageReference-zero constraint applies
      to src only (ADR 0013 scope), so BenchmarkDotNet here is not a
      violation. Benchmarks MUST run with `-c Release` - BenchmarkDotNet
      refuses Debug builds.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AdapterSdk/SignalRouter.AdapterSdk.csproj" />
    <ProjectReference Include="../../src/Codec.CanonicalState/SignalRouter.Codec.CanonicalState.csproj" />
    <ProjectReference Include="../../src/Contracts/SignalRouter.Contracts.csproj" />
    <ProjectReference Include="../../src/Kernel/SignalRouter.Kernel.csproj" />
  </ItemGroup>
</Project>
